{
  "name": "dsh-tool-autoexpand",
  "version": "0.2.1",
  "description": "在 DSH web 界面自动展开工具调用卡片，支持侧边栏开关。标准可安装的 dsh 客户端插件。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tool-call",
    "autoexpand",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-er/dsh-tool-autoexpand.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "docs/"
  ],
  "license": "MIT"
}
