{
  "name": "dsh-tool-autoexpand",
  "version": "0.3.2",
  "description": "「DSH·工具结果自动展开」：在 DSH web 界面自动展开工具调用卡片，支持侧边栏开关。标准可安装的 dsh 客户端插件。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tool-call",
    "autoexpand",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-er/dsh-tool-autoexpand.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc -b --pretty false"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/index.d.ts",
    "cordis.patch.yml",
    "docs/"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=26.3.1"
  },
  "packageManager": "pnpm@9.15.9",
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2",
    "@deepseek-ai/cordis": "^4.0.4",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  }
}
